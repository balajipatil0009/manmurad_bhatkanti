DATABASE_URL=postgresql://<user>:<password>@ep-<id>-pooler.<region>.aws.neon.tech/neondb?sslmode=require
PAYLOAD_SECRET=your-payload-secret

# Public URL of the deployment. Must match the browser origin exactly
# (no trailing slash) — Payload authenticates admin writes against it.
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Vercel Blob storage token. Required in production (uploads go to Blob;
# the serverless filesystem is read-only). Vercel injects it automatically
# when you connect a Blob store to the project (Storage tab).
# Leave unset for local dev — uploads then use the local media/ folder.
BLOB_READ_WRITE_TOKEN=
